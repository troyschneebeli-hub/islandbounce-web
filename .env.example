# Copy to .env.local and fill in once affiliate applications are approved.
NEXT_PUBLIC_12GO_PARTNER_ID=
NEXT_PUBLIC_KLOOK_AID=
NEXT_PUBLIC_VIATOR_PID=
NEXT_PUBLIC_GYG_PARTNER_ID=

# GOOGLE_MAPS_API_KEY (server-side) is no longer used: the two API routes that
# needed it were removed in Oct 2026. You can delete it from Vercel and
# .env.local, and revoke that key in Google Cloud Console.

# Different key from the one above — this one IS sent to the browser
# (that's what NEXT_PUBLIC_ means), so it can't be restricted by server IP.
# Used by the Find My Port page (components/FindPortMap.js — the
# futuristic interactive map with real drawn driving routes) and
# components/AddressAutocomplete.js (address suggestions as you type).
# In Google Cloud Console: create a SEPARATE key, enable ALL THREE of
# "Maps JavaScript API", "Places API", and "Directions API" on it, and
# restrict it by HTTP referrer to your real domain
# (e.g. islandbouncetravel.com/*) — not by IP, since browser requests
# come from visitors' IPs, not your server's.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Once eventide.com is live, point this at the real domain.
NEXT_PUBLIC_EVENTIDE_URL=https://eventide.com

# Optional: where the Split Charters "Notify me" form sends signups. Any
# service that accepts a JSON POST works (e.g. a Formspree form URL). If left
# empty, the form falls back to opening the visitor's email app addressed to
# the contact email in lib/site.js.
NEXT_PUBLIC_WAITLIST_ENDPOINT=
